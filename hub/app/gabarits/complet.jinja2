{# titre: Compte rendu complet #}
{# version: 3.5.0 #}
{# format: html #}
{% from 'placenta_rubriques.inc' import rubrique_placenta, titre_placenta %}
{%- macro serie_horizontale(serie) -%}
{% for valeur, renvoi in serie %}{% if not loop.first %}&nbsp; {% endif %}<span style="display:inline-block;white-space:nowrap">{{ valeur }}<sup>{{ renvoi }}</sup></span>{% endfor %}
{%- endmacro -%}
{%- macro tableau(lignes, references, compact=false) -%}
{% set avec_terme = lignes | selectattr('4') | list %}
{% set titres = ['Paramètre', 'Valeur', 'Percentile', 'DS'] + (['Terme attendu'] if avec_terme else []) %}
{% set cellule = 'border:1px solid #333;padding:2pt 4pt;vertical-align:middle;text-align:center;font-family:Arial,sans-serif;font-size:9pt;white-space:normal;' %}
<table{% if compact %} align="center"{% endif %} style="{{ 'width:86%;max-width:600px;margin:4pt auto 5pt;' if compact else 'width:100%;margin:4pt 0 5pt;' }}border-collapse:collapse;table-layout:auto;white-space:normal">
<thead style="display:table-header-group"><tr>{% for t in titres %}<th scope="col" style="{{ cellule }}background:#eee;{% if loop.first %}width:{{ '24%' if compact else '26%' }};{% elif compact and loop.index == 2 %}width:12%;{% endif %}">{{ t }}</th>{% endfor %}</tr></thead>
<tbody>
{% for ligne in lignes %}<tr style="break-inside:avoid;page-break-inside:avoid">
<th scope="row" style="{{ cellule }}text-align:left;font-weight:normal">{{ ligne[0] }}</th>
<td style="{{ cellule }}">{{ ligne[1] }}</td>
<td style="{{ cellule }}white-space:nowrap">{{ serie_horizontale(ligne[2]) }}</td>
<td style="{{ cellule }}{% if compact %}white-space:nowrap{% endif %}">{% if compact %}{{ serie_horizontale(ligne[3]) }}{% else %}{% for valeur, renvoi in ligne[3] %}{% if not loop.first %}<br>{% endif %}{{ valeur }}<sup>{{ renvoi }}</sup>{% endfor %}{% endif %}</td>
{% if avec_terme %}<td style="{{ cellule }}">{{ ligne[4] }}</td>{% endif %}
</tr>{% endfor %}
</tbody>
</table>
{% if references %}<p style="font:9pt Arial,sans-serif;{{ 'width:86%;max-width:600px;margin:0 auto 5pt;' if compact else 'margin:0 0 5pt;' }}break-before:avoid;page-break-before:avoid">
{% for renvoi, reference in references %}{% if not loop.first %} · {% endif %}<sup>{{ renvoi }}</sup> {{ reference }}{% endfor %}
</p>{% endif %}
{%- endmacro -%}
{%- macro bloc(section, niveau=2, espacer=true) -%}
{% if section.paragraphes is defined -%}
{{ rubrique_placenta(section, niveau) }}
{% else %}
{% if section.titre_placenta_word %}
{{ titre_placenta(niveau) }}
{% elif section.titre %}<h{{ niveau }} style="font: bold {{ '12' if niveau == 2 else '10' }}pt Arial,sans-serif;margin:{{ '12' if espacer else '5' }}pt 0 2pt;break-after:avoid;page-break-after:avoid">{{ section.titre }}</h{{ niveau }}>{% endif %}
{% for ligne in section.lignes %}<p style="margin:0 0 2pt;white-space:pre-line">{{ ligne }}</p>{% endfor %}
{% if section.mesures %}
{% set compact = (section.biometrie | default(false)) or section.titre == 'Poids des organes' %}
{{ tableau(section.mesures, section.references_mesures, compact) }}
{% endif %}
{% for sous in section.sous %}{{ bloc(sous, [niveau + 1, 5] | min, (not loop.first or section.lignes or section.mesures)) }}{% endfor %}
{% endif %}
{%- endmacro -%}
{%- macro administratif(section) -%}
<section style="font:12pt/1.15 'Times New Roman',serif">
<h2 style="font:bold 12pt Arial,sans-serif;margin:12pt 0 2pt;break-after:avoid;page-break-after:avoid">{{ section.titre }}</h2>
{% for ligne in section.lignes %}
{% if ligne is string %}
<p style="margin:0 0 2pt;white-space:pre-line">{{ ligne }}</p>
{% elif ligne.liste %}
<p style="margin:0 0 2pt;break-after:avoid;page-break-after:avoid">{{ ligne.intitule }}&nbsp;:</p>
<ul style="margin:0 0 2pt;padding-left:36pt;list-style-type:disc;list-style-type:'-  '">
{% for antecedent in ligne.liste %}<li style="margin:0 0 2pt">{{ antecedent }}</li>{% endfor %}
</ul>
{% else %}
<p style="margin:{{ '14' if ligne.espacer else '0' }}pt 0 2pt;white-space:pre-line"><u>{{ ligne.intitule }}</u>{% if ligne.texte %} : {{ ligne.texte }}{% else %}.{% endif %}</p>
{% endif %}
{% endfor %}
</section>
{%- endmacro -%}
<article style="font:10pt/1.35 Arial,sans-serif;white-space:normal;color:#171717">
<div style="font:12pt/1.15 'Times New Roman',serif">
<h1 style="font:bold 16pt Arial,sans-serif;margin:0 0 4pt">Compte rendu d’examen fœtopathologique</h1>
<p style="margin:0">Dossier n° {{ dossier }}{% if terme.sa is not none %} · {{ terme.texte }}{% endif %}</p>
{% if demonstration %}<p style="margin:0">Cas de démonstration</p>{% endif %}
{% if not demonstration and (identite.nom_mere or identite.prenom_mere) %}<p style="margin:0">Mère : {{ identite.nom_mere or '' }} {{ identite.prenom_mere or '' }}.</p>{% endif %}
{% if circuit.date_examen %}<p style="margin:0">Examen du {{ date_variable(circuit.date_examen) }}.</p>{% endif %}
</div>
{% for section in complet_sections() %}{{ administratif(section) if section.administratif else bloc(section) }}{% endfor %}
</article>
